Module
  name: client
  description: Initialize the client and setups its main window
  author: edubart
  website: https://github.com/edubart/otclient
  reloadable: false
  sandboxed: true
  scripts: [ client ]
  @onLoad: init()
  @onUnload: terminate()

  load-later:
    - client_styles
    - client_locales
    - client_topmenu
    // client_bottommenu fuera (Duelfall 2026-07-24): paneles Event Schedule /
    // Boosted / showOff + logo "OTClient Redemption" del login; todo es chrome
    // Tibia-RL sin webservice. entergame guarda sus llamadas con isLoaded().
    - client_background
    - client_options
    - client_entergame
    - client_terminal
    - client_debug_info
    - client_serverlist
